# Application Environment Configuration Example
# Copy to .env and fill in real values. .env is gitignored -- never commit it.
# If a real credential was ever committed to history, ROTATE it.

PORT=5000
FRONTEND_PORT=5173
NODE_ENV=production

# Comma-separated list of allowed browser origins for CORS.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Database Configuration (PostgreSQL 16)
# DB_PASSWORD is REQUIRED -- the backend refuses to start without it.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=casevault
DB_USER=casevault
DB_PASSWORD=your_secure_db_password_here
DB_SCHEMA=investigation
# Set to "true" to require TLS to the database.
DB_SSL=false

# Security & Session
SESSION_SECRET=your_high_entropy_session_secret_here
STORAGE_VAULT_PATH=./data/documents/vault

# ---------------------------------------------------------------------------
# Blockchain / integrity ledger
# ---------------------------------------------------------------------------
# Quorum consensus: how many of the 4 sovereign bodies (POLICE, JUDICIARY,
# FORENSICS, MASTER) must independently validate + co-sign a block before it
# becomes FINAL. Must be 1..4. Default 3.
CONSENSUS_QUORUM=3

# External anchoring target for checkpoint Merkle roots.
#   LOCAL_NOTARY    (default) offline MASTER-key countersignature; no network.
#   RFC3161_TSA     POST the root to an RFC-3161 timestamp authority (set ANCHOR_TSA_URL).
#   OPENTIMESTAMPS  submit to an OpenTimestamps calendar (set ANCHOR_OTS_URL).
# Only the 32-byte root is ever transmitted -- never PII or payloads.
ANCHOR_TARGET=LOCAL_NOTARY
# ANCHOR_TSA_URL=https://freetsa.org/tsr
# ANCHOR_OTS_URL=https://a.pool.opentimestamps.org/digest
